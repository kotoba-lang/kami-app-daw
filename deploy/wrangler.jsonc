{
  // KAMI DAW at daw.itonami.cloud.
  //
  // A SUBDOMAIN, not a path. itonami.cloud's apex is a Cloudflare Pages
  // project (`cloud-itonami`, the operator cockpit) bound as a custom domain,
  // and a Pages custom domain takes the whole hostname — a Worker route for
  // `itonami.cloud/daw*` registers fine and never fires (measured on the genko
  // route: it was the only route on the zone and the cockpit still answered).
  // Subdomains are what this zone already does for Workers anyway:
  // hooks./app./mcp.itonami.cloud are all custom domains.
  //
  // Assets-only — no `main`. The page is a build artifact and the app is a
  // cljs bundle; projects live in the browser. No D1, no R2, no secrets.
  "name": "itonami-daw",
  "compatibility_date": "2025-03-17",
  "assets": { "directory": "../public" },
  "routes": [{ "pattern": "daw.itonami.cloud", "custom_domain": true }]
}
