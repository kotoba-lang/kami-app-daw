{
  // Static host for KAMI DAW at daw.gftd.ai.
  //
  // Assets-only: no `main`, because there is nothing for a Worker to do. The
  // page is a build artifact (scripts/gen-page.cljs -> public/index.html) and
  // the app is a cljs bundle; projects live in the browser (localStorage,
  // IndexedDB, .kami.zip files the user saves). No D1, no R2, no secrets.
  //
  // GitHub Pages was the previous host, but Actions are disabled org-wide
  // (ADR-2607300900), so that workflow no longer runs and the Pages site
  // serves whatever was built before the sweep.
  //
  // Deploy:
  //   npx shadow-cljs release app && npm run page
  //   npx wrangler deploy -c deploy/wrangler.jsonc
  "name": "kami-app-daw",
  "compatibility_date": "2025-03-17",
  "assets": { "directory": "../public" },
  "routes": [{ "pattern": "daw.gftd.ai/*", "zone_name": "gftd.ai" }]
}
